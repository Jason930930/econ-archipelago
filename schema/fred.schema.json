{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "經濟群島 FRED 快照",
  "type": "object",
  "additionalProperties": false,
  "required": ["fetchedAt", "series"],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "properties": {
    "fetchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "series": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cadence", "latest", "samples"],
        "properties": {
          "cadence": { "enum": ["daily", "monthly"] },
          "latest": { "$ref": "#/$defs/point" },
          "samples": { "type": "array", "items": { "$ref": "#/$defs/point" } }
        }
      }
    }
  }
}
