{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jason930930.github.io/econ-archipelago/schema/week.schema.json",
  "title": "經濟群島週資料 v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "weekId",
    "period",
    "title",
    "indicators",
    "events",
    "links",
    "storylines",
    "watchlist"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "unit": {
          "type": "string"
        },
        "changePct": {
          "type": [
            "number",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "date",
        "title",
        "what",
        "why",
        "discrepancy",
        "taiwanImpact",
        "primary",
        "places",
        "sentiment",
        "storylines",
        "metrics",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^e[0-9]+$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        },
        "what": {
          "$ref": "#/$defs/nonEmpty"
        },
        "why": {
          "$ref": "#/$defs/nonEmpty"
        },
        "discrepancy": {
          "type": [
            "string",
            "null"
          ]
        },
        "taiwanImpact": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "direction",
                "channels"
              ],
              "properties": {
                "summary": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "direction": {
                  "enum": [
                    -1,
                    0,
                    1
                  ]
                },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "primary": {
          "$ref": "#/$defs/path"
        },
        "places": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "sentiment": {
          "type": "integer",
          "minimum": -3,
          "maximum": 3
        },
        "storylines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "change": {
                "type": "string"
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "channels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "path": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*){0,2}$"
    },
    "newEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "region",
        "sector",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "sector": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "weekId": {
      "$ref": "#/$defs/date"
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/date"
        },
        "end": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "title": {
      "$ref": "#/$defs/nonEmpty"
    },
    "indicators": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brent": {
          "$ref": "#/$defs/indicator"
        },
        "wti": {
          "$ref": "#/$defs/indicator"
        },
        "fedFunds": {
          "$ref": "#/$defs/indicator"
        },
        "us10y": {
          "$ref": "#/$defs/indicator"
        },
        "sp500": {
          "$ref": "#/$defs/indicator"
        },
        "nasdaq": {
          "$ref": "#/$defs/indicator"
        },
        "dow": {
          "$ref": "#/$defs/indicator"
        },
        "taiex": {
          "$ref": "#/$defs/indicator"
        },
        "cpiYoY": {
          "$ref": "#/$defs/indicator"
        },
        "gold": {
          "$ref": "#/$defs/indicator"
        },
        "btc": {
          "$ref": "#/$defs/indicator"
        },
        "usdtwd": {
          "$ref": "#/$defs/indicator"
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "label"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          }
        }
      }
    },
    "storylines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "$ref": "#/$defs/nonEmpty"
          }
        }
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "text",
          "places",
          "confirmed"
        ],
        "properties": {
          "date": {
            "anyOf": [
              {
                "$ref": "#/$defs/date"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "$ref": "#/$defs/nonEmpty"
          },
          "places": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "confirmed": {
            "type": "boolean"
          }
        }
      }
    },
    "newEntities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/newEntity"
      }
    },
    "proposedChannels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fromPath",
          "toPath",
          "fromVar",
          "toVar",
          "sign",
          "mechanism",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fromPath": {
            "$ref": "#/$defs/path"
          },
          "toPath": {
            "$ref": "#/$defs/path"
          },
          "fromVar": {
            "type": "string"
          },
          "toVar": {
            "type": "string"
          },
          "sign": {
            "enum": [
              -1,
              1
            ]
          },
          "mechanism": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
